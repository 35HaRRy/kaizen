{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && corepack pnpm install --frozen-lockfile",
  "buildCommand": "cd .. && corepack pnpm --filter kaizen run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/api(?:/(.*))?$",
      "dest": "${API_ORIGIN}/api/$1",
      "env": ["API_ORIGIN"],
      "respectOriginCacheControl": false,
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-origin-secret" },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/index.html"
    }
  ]
}
