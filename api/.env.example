# Install as /srv/kaizen/config/production.env on the server only.
# Keep the EXISTING MongoDB URI, public port, allowlist and TLS settings unchanged.
# Container connectivity must be verified; never silently rewrite its address.
MONGODB_URI=
MONGODB_DB=kaizen
APP_ORIGIN=https://www.example.com
# Generate: openssl rand -hex 32. Set identical value in Vercel ORIGIN_SECRET.
ORIGIN_SECRET=
TURNSTILE_SECRET_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=kaizen-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_ORIGIN=https://media.example.com
